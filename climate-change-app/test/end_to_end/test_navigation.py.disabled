
import multiprocessing
import re
import time

import pytest
from flask import Flask
from playwright.sync_api import Page, expect, sync_playwright
from werkzeug import run_simple

from flaskapp import create_app
from test.test_config import test_client, TestConfig, init_filled_database

def run_server():
    app = create_app(TestConfig)
    run_simple('localhost', 5050, app)

@pytest.fixture(scope="session")
def browser():
    with sync_playwright() as playwright:
        browser = playwright.chromium.launch(headless=False)
        yield browser
        browser.close()

@pytest.fixture
def page(browser):
    page = browser.new_page()
    yield page
    page.close()


@pytest.fixture(scope='session', autouse=True)
def server():
    # Start a separate process to run the server
    server_process = multiprocessing.Process(target=run_server)
    server_process.start()

    # Give the server some time to start
    time.sleep(1)

    yield  # testing happens here

    # Stop the server process after testing
    server_process.terminate()


def test_navigation(page, test_client, init_filled_database):
    base_url = "http://localhost:5050"
    
    page.goto(f"{base_url}/")

    expect(page.get_by_text("Together We Thrive")).to_be_visible()

    page.get_by_role("link", name="Register").click()
    expect(page.get_by_role("heading", name="Register")).to_be_visible()

    page.get_by_role("link", name="ClimateChamps.org").click()
    expect(page.get_by_text("Together We Thrive")).to_be_visible()

    page.get_by_role("link", name="Login").first.click()
    expect(page.get_by_role("heading", name="Account Login")).to_be_visible()

    page.get_by_role("link", name="Login").click()
    page.get_by_placeholder("Username").click()
    page.get_by_placeholder("Username").fill("admin1")
    page.get_by_placeholder("Username").press("Tab")
    page.get_by_placeholder("Password").fill("Admin1!")
    page.get_by_placeholder("Password").press("Tab")
    page.get_by_placeholder("Pin").fill("123456")

    page.get_by_role("button", name="Submit").click()
