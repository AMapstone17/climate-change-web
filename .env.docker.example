# example .env file for running the app using Docker
# copy this file to .env.docker.local and fill in the values


# Flask
# The database URI to connect to. This shouldn't need to be changed.
FLASK_SQLALCHEMY_DATABASE_URI = postgresql://postgres:some_password_here@db:5432/climate

# Standard SQLAlchemy settings
FLASK_SQLALCHEMY_ECHO = True
FLASK_SQLALCHEMY_TRACK_MODIFICATIONS = False

# The secret key for Flask
FLASK_SECRET_KEY=SECRET_KEY

# Recaptcha keys
FLASK_RECAPTCHA_PUBLIC_KEY =
FLASK_RECAPTCHA_PRIVATE_KEY =

# Should 2FA be bypassed?
FLASK_BYPASS_2FA = False

# Should Recaptcha be bypassed?
FLASK_BYPASS_RECAPTCHA = True


# Postgres DB
POSTGRES_PASSWORD=some_password_here
POSTGRES_DB=climate